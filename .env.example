BOT_TOKEN=1234567890:replace_me
ADMIN_TELEGRAM_ID=123456789
# Можно оставить пустым: тогда первым участником станет первый не-администратор,
# который отправит /start. После привязки ID сохраняется в data/bot.db.
SONYA_TELEGRAM_ID=

# Поддерживаются http://, socks4://, socks5://, включая логин/пароль.
# Пример: socks5://user:password@127.0.0.1:1080
PROXY_URL=

QUEST_START_DELAY_SECONDS=300
ROADMAP_PATH=roadmap/quest.json
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
